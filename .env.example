# ── STAGEPASS SECURITY & JWT SECRETS ──
# Minimum 32 characters signing key for JWT tokens
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-this

# ── GOOGLE OAUTH2 CREDENTIALS ──
# Create a web application credential in Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── GITHUB OAUTH2 CREDENTIALS ──
# Create an OAuth Application in GitHub Developer Settings
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ── RAZORPAY GATEWAY CREDENTIALS ──
# Create an API Key in Razorpay Dashboard Settings (Test Mode)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
